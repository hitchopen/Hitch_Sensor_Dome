{
  /*** ROS-related config ***/
  // --- Backend modules ---
  // If both local and global mapping are disabled, odometry estimation runs.
  // enable_local_mapping   : Enable local mapping module
  // enable_global_mapping  : Enable global mapping module
  //
  // --- Points config ---
  // keep_raw_points        : Keep raw points in the map (required for only extension modules)
  //
  // --- IMU config ---
  // imu_time_offset        : Time offset for IMU data (in seconds)
  // acc_scale              : Accelerometer scale factor (Set to 9.80665 for Livox sensors)
  //
  // --- TF config ---
  // GLIM publishes TF subtrees "map -> odom -> base_frame" and "imu -> lidar".
  // imu_frame_id           : IMU frame ID (If blank, auto-detected from IMU topic)
  // lidar_frame_id         : LiDAR frame ID (If blank, auto-detected from points topic)
  // base_frame_id          : Base frame ID. If blank, IMU frame ID is used.
  // odom_frame_id          : Odometry frame ID
  // map_frame_id           : Map frame ID
  // publish_imu2lidar      : If false, do not publish "imu -> lidar" TF
  // tf_time_offset         : Time offset for TF data (in seconds)
  //
  // --- Extension modules ---
  // extension_modules      : List of extension modules to load
  //
  // --- Topics ---
  // imu_topic              : IMU topic
  // points_topic           : Points topic
  // image_topic            : Image topic (required for only extension modules)
  //
  // --- QoS options ---
  // imu_qos                : QoS options for IMU topic subscription.
  //   profile              : Builtin QoS profile name. Could be one of the following:
  //                          default, system_default, sensor_data, services_default, parameters, parameter_events
  //   depth                : Size of the message queue.
  //   durability           : Durability QoS policy setting. Could be one of the following:
  //                          system_default, transient_local, volatile
  //   reliability          : Reliabiilty QoS policy setting. Could be one of the following:
  //                          system_default, reliable, best_effort
  //   history              : History QoS policy setting. Could be one of the following:
  //                          system_default, keep_last, keep_all
  // points_qos             : QoS options for points topic subscription. See imu_qos for details.
  // image_qos              : QoS options for image topic subscription. See imu_qos for details.
  "glim_ros": {
    // Online (live subscription) mapping passway. DISABLED: GLIM builds maps
    // OFFLINE only -- run `glim_rosbag <bag>` or `glim_pcap_rosbag <pcap>`,
    // which feed the IMU/points/GNSS callbacks directly and drive
    // timer_callback() manually. When false the live node (glim_rosnode)
    // refuses to run and no live ROS subscriptions / wall timer are created.
    // Set true ONLY to restore the legacy live-sensor mapping path.
    "enable_online_mapping": false,
    // Backend modules
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    // Points config
    "keep_raw_points": false,
    // IMU config
    "imu_time_offset": 0.00,
    "points_time_offset": 0.0,
    // Atlas Duo (Point One Nav) outputs linear acceleration in m/s² natively,
    // so leave the scale factor at 1.0. The auto-detect mode (0.0) was
    // explicitly recommended away from in the upstream Claude tuning review.
    "acc_scale": 1.0,
    // TF config — body frame for the global map.
    //
    // base_frame_id = "imu_link" makes GLIM build the map relative to the
    // Atlas Duo Center of Navigation (the parent of every transform in
    // config/sensor_dome_tf.yaml). Per-vehicle calibrations can then publish
    // a single static "imu_link → base_link" transform downstream — the map
    // itself stays vehicle-agnostic and reusable across platforms.
    //
    // imu_frame_id and lidar_frame_id are pinned to match the static-TF
    // chain in sensor_dome_tf.yaml so GLIM's auto-detect can't drift if a
    // driver renames its frame.
    "imu_frame_id": "imu_link",
    "lidar_frame_id": "lidar_front_link",
    "base_frame_id": "imu_link",
    "odom_frame_id": "odom",
    "map_frame_id": "map",
    "publish_imu2lidar": true,
    "tf_time_offset": 1e-6,
    // Extension modules.
    // libimu_validator.so is enabled by default during bring-up so any
    // gravity / scale / extrinsic mismatch surfaces in the GLIM viewer
    // before it corrupts the map. Disable it once the rig has been
    // characterized and the IMU validator reports clean for several runs.
    // libgnss_global.so adds GNSS-position factors to the iSAM2 global graph
    // whenever a usable RTK-FIXED sample arrives on the gnss topic configured
    // in config_gnss_global.json. The primary trajectory comes from
    // LiDAR + IMU odometry (config_odometry_gpu.json), so during GNSS-denied
    // passages the GNSS factor stream simply goes silent and LiDAR+IMU alone
    // drives mapping. Once RTK reacquires, the next GNSS factor pulls the
    // post-dropout trajectory back into the global frame; iSAM2 smooths the
    // dropout retroactively.
    "extension_modules": [
      "libmemory_monitor.so",
      "libstandard_viewer.so",
      "librviz_viewer.so",
      "libgnss_global.so",
      "libimu_validator.so"
    ],
    // Topics — Hitch Sensor Dome conventions.
    //   /imu/data               fusion_engine_driver (sensor_msgs/Imu @ 200 Hz)
    //   /robin_w_front/points   seyond driver, the primary stitched cloud.
    //                           rear-left and rear-right are merged into
    //                           this topic by the lidar_concat block in
    //                           config_sensors.json.
    "imu_topic": "/imu/data",
    "points_topic": "/robin_w_front/points",
    "image_topic": "/cam_front_left/image_raw",
    // Hitch Sensor Dome fork: external INS init with RTK-fixed gating.
    //
    // The C++ wrapper (glim_ros2/src/glim_ros/glim_ros.cpp) subscribes
    // to ins_pose_topic and forwards the first INS pose that passes the
    // gate to OdometryEstimationIMU::set_init_state. The gate consists
    // of three sequential checks:
    //
    //   (1) NavSatFix.status >= STATUS_GBAS_FIX  (RTK-class)
    //   (2) NavSatFix.position_covariance diagonal stddev <= max threshold
    //   (3) the most recent N pose samples are mutually consistent
    //       (translation jitter < trans threshold, |q1·q2| > quat threshold)
    //
    // Until the gate passes, glim_rosnode is blocked at initialization
    // and prints a periodic bold RED warning naming the rejection reason.
    // See GLIM/docs/moving_start_initialization.md for the full design.
    //
    // ins_fix_topic                — synchronized adapter NavSatFix gate
    //                                 signal (default /gps_p1/fix).
    // ins_require_rtk_fixed        — true ⇒ enforce RTK-class status.
    //                                false ⇒ accept SBAS / single-point too
    //                                (degraded; only use without RTK base).
    // ins_max_position_stddev      — max allowed σ on NavSatFix covariance (m).
    //                                0.10 ≈ RTK-fixed; raise for SBAS-class.
    // ins_min_pose_window_samples  — consecutive consistent samples required.
    // ins_max_pose_jitter_trans    — max translation drift (m) between samples.
    // ins_min_quat_dot             — min |q1·q2| between samples (0.999 ≈ 2.5°).
    // ins_init_timeout_s           — seconds before warning escalates to "TIMEOUT".
    // NOTE (B4 fix): these settings apply in BOTH modes — offline replay
    // (glim_rosbag / glim_pcap_rosbag reads the same topics from the bag
    // and feeds the gate callbacks directly) and the optional live path.
    // Production source: the adapter publishes this topic only when the
    // FusionEngine solution_type is exactly kRtkFixed and its covariance is
    // finite/in-range. Using that source makes Fixed-vs-Float an authoritative
    // upstream decision instead of a REP-145 NavSatFix heuristic.
    "ins_pose_topic": "",
    // Initialization source. PoseStamped (/pose) carries no velocity and no
    // FusionEngine solution_type, so it is compatibility-only. Production
    // points ins_odom_topic at the adapter's FIXED-ONLY stream and clears
    // ins_pose_topic —
    //   "ins_pose_topic": "",
    //   "ins_odom_topic": "/gps_p1/filtered_odom_rtk_fixed",
    // nav_msgs/Odometry carries P1's own velocity, which is authoritative
    // for a tightly-coupled INS and avoids the finite-difference estimate.
    // The topic itself is emitted only for solution_type == kRtkFixed; the
    // synchronized NavSatFix companion below supplies the covariance, WGS84
    // position, and timestamp checks.
    "ins_odom_topic": "/gps_p1/filtered_odom_rtk_fixed",
    "ins_fix_topic":  "/gps_p1/fix",
    // SLAM STARTS ONLY AT RTK-FIXED. Initialization waits for a fresh,
    // validated RTK-class fix: the map origin must be globally referenced
    // and the INS attitude validated before any factor is built. Leaving
    // this true is the production posture. False accepts valid non-RTK fixes
    // and, when NavSatFix is absent, permits Odometry only if its own finite,
    // positive position covariance passes ins_max_position_stddev. A
    // covariance-less PoseStamped still fails closed.
    // NOTE: after initialization, RTK loss does NOT stop mapping — GNSS
    // factors simply suspend and LiDAR-IMU SLAM carries the trajectory.
    "ins_require_rtk_fixed": true,
    "ins_max_position_stddev": 0.10,
    // INS stability gate — MOVING-START CAPABLE (2026-07-27).
    // The Atlas Duo is a tightly-coupled INS, so its calibration/attitude/
    // velocity are P1's responsibility. This gate therefore only checks that
    // P1's solution is SETTLED and SELF-CONSISTENT; it does NOT require the
    // vehicle to be stationary.
    //
    // ins_min_pose_window_samples — consecutive contiguous samples required
    //   (floored at 3, since a constant-velocity prediction needs three).
    //   10 samples at the Atlas's 10 Hz = 1.0 s of settled solution.
    "ins_min_pose_window_samples": 10,
    // ins_max_pose_jitter_trans — max position RESIDUAL (m) against a
    //   constant-velocity prediction from the two preceding samples. NOT a
    //   displacement bound: steady motion at any speed gives ~0 residual.
    //   Under constant acceleration a the residual is a*dt^2, so 0.05 m at
    //   10 Hz tolerates ~5 m/s^2 (0.5 g) of real vehicle dynamics before the
    //   solution is called unsettled. Raise it if mapping runs start under
    //   harder acceleration; lower it to demand a calmer start.
    "ins_max_pose_jitter_trans": 0.05,
    // ins_min_quat_dot — same idea for attitude: |q_pred . q| against a
    //   constant-angular-rate prediction. 0.999 ~ 2.5 deg of residual, i.e.
    //   ~250 deg/s^2 of angular acceleration at 10 Hz. A steady turn passes
    //   at any rate; an attitude snap does not.
    "ins_min_quat_dot": 0.999,
    // ins_max_pose_gap_s — max gap (s) between consecutive accepted samples
    //   before the window is discarded as non-contiguous. Samples enter the
    //   window only after the RTK gates pass, so without this a fix that
    //   flickers into RTK once every N seconds could assemble a "stable"
    //   window out of moments minutes apart.
    "ins_max_pose_gap_s": 0.5,
    // --- Fix freshness (B3 fix, 2026-07-27) ---
    // A NavSatFix authorizes a gating decision only while it is FRESH.
    // Age is measured between MESSAGE header stamps (the pose being gated
    // vs the fix), never wall time — offline replay runs at arbitrary
    // speed. Without this a single RTK sample licensed initialization and
    // every GNSS factor for the rest of a session, even while the receiver
    // was dead-reckoning. At the Atlas's 10 Hz fix rate 0.5 s is
    // conservative (5 missed messages).
    "fix_max_age_s": 0.5,
    // Small allowance for a fix stamped marginally ahead of the pose it
    // gates (benign publisher-side ordering). Beyond this the fix is
    // refused as implausibly future-dated.
    "fix_future_tolerance_s": 0.05,
    // Operator policy for the END OF RUN. LiDAR-IMU SLAM is the primary
    // estimator; GNSS is an optional global constraint. A map whose origin
    // is RTK-anchored but which saw no further RTK is reported
    // "rtk_origin_only" and ACCEPTED by default. Set true to make that an
    // exit-nonzero failure (a run that never initialized always fails).
    "require_rtk_anchor": false,
    "ins_init_timeout_s": 60.0,
    // GNSS factor bridge (post-init, RTK-gated republisher feeding
    // libgnss_global.so — gnss_topic in config_gnss_global.json must match
    // gnss_factor_topic). Offline, accepted samples are handed to the
    // extension module directly as well as published.
    "gnss_factor_topic": "/gnss/pose_rtk_only",
    "gnss_factor_require_rtk_fixed": true,
    "gnss_factor_max_position_stddev": 0.10,
    // Dual-antenna RTK heading. Keep in sync with the secondary-antenna
    // translation in config/sensor_dome_tf.yaml (repo root): baseline is
    // the primary→secondary distance; heading σ ≈ 0.01 m RTK noise /
    // baseline. The hitch_sensor_dome launch prints the exact values to
    // paste here when it detects a configured secondary antenna.
    "dual_antenna_enabled": false,
    "dual_antenna_baseline_m": 0.0,
    "dual_antenna_heading_sigma_rad": 0.0,
    // QoS — match recording/sensor_config.yaml so GLIM can subscribe
    // directly to the live drivers or replay an .mcap bag.
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "sensor_data",
      "reliability": "best_effort"
    },
    "image_qos": {
      "profile": "sensor_data"
    }
  }
}
