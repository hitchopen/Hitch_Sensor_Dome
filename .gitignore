# macOS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Thumbnails
Thumbs.db
ehthumbs.db

# OpenSCAD backup/cache files
*.scad~
*.scad.bak

# Python cache
__pycache__/
*.pyc

# GLIM build artifacts (do not commit compiled output)
GLIM_plusplus/build/
GLIM_plusplus/install/
GLIM_plusplus/log/
# Defensive: catch any accidental nested copy of glim/ inside GLIM_plusplus/config/.
GLIM_plusplus/config/glim/

# GLIM map output (large; produced per session)
glim_maps/

# Recording sessions (large MCAP bags — keep out of git).
# The recording/data/ folder itself is tracked via .gitkeep, but
# every session_* subdir written by sensor_recorder.py is ignored.
recordings/
recording/sessions/
recording/data/*
!recording/data/.gitkeep

# Office documents (generated review reports, drafts, etc. — do not commit)
*.docx
*.doc
~$*.docx
~$*.doc
*.xlsx
*.xls
~$*.xlsx
~$*.xls
*.pptx
*.ppt
~$*.pptx
~$*.ppt

# Working review / analysis notes — private, not part of the shipped package.
#
# Every README in this repository is deliberately SELF-CONTAINED: no README
# links into these folders, so ignoring them cannot produce a broken link.
# Relative links in the READMEs point only at tracked source/config files;
# everything else is an external URL. Keep it that way — if a README ever needs
# something that lives here, inline the content rather than adding a link.
#
# These patterns are ANCHORED with a leading slash on purpose. An unanchored
# `docs/` matches a directory named `docs` at ANY depth, which silently
# swallowed upstream GLIM's own documentation site at
# GLIM_plusplus/glim/docs/ — harmless only for as long as those files stayed
# tracked, and a silent data-loss trap on the next upstream re-sync.
/docs/
/GLIM_plusplus/docs/
/adapter/MERGE_NOTES_*.md

# Staging area for files queued for deletion. Cowork's device bridge cannot
# unlink files inside a connected folder, so anything to be removed is moved
# here instead and deleted by hand afterwards. Never commit it.
#
# Deliberately UNANCHORED, unlike the patterns above: one of these can be
# created next to whatever file is being retired, at any depth. There is no
# upstream directory by this name to collide with.
_to_delete/
